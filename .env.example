# Copy to .env and fill in before `docker compose up --build`.
# docker compose reads .env from the project root automatically.

# --- Weights/engines restore (optional) ---
# If set, the triton container's entrypoint (docker/triton/entrypoint.sh)
# runs `aws s3 sync` into the inference-data volume the first time it looks
# empty. Leave unset if you're populating that volume another way (a
# from-scratch engine build per deploy/REBUILD.md section 4, or copying
# files in directly).
S3_BUCKET_URI=s3://your-bucket/speech-cascade-inference/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Gateway ---
GATEWAY_PORT=18010
# Total concurrent sessions across all clients -- protects the GPU.
GATEWAY_MAX_SESSIONS=4
# Per-API-key cap, so one client cannot take every slot and starve the rest.
# Only meaningful with GATEWAY_API_KEYS (a shared token has no identity).
GATEWAY_MAX_SESSIONS_PER_KEY=2

# Auth for /ws/stream. Required here: this deployment has no Vast.ai Caddy
# auth edge in front of it, so the gateway checks credentials itself. It
# REFUSES TO START if none of the three settings below is set -- a missing
# variable should stop the process, not publish an open endpoint.
#
# PREFERRED: named API keys. Individually revocable, named in the logs, and
# what makes GATEWAY_MAX_SESSIONS_PER_KEY work. Mint one with:
#
#     python3 -m streaming_gateway.auth --new alice
#
# which prints the key to hand the client (once -- it is not recoverable)
# and the entry to put here. Only the SHA-256 is stored, so this file never
# holds a usable credential. Comma-separate further keys; revoke by deleting
# an entry. Clients send `Authorization: Bearer <key>`.
GATEWAY_API_KEYS=

# LEGACY: one shared token for everyone. Still honored so the bare-metal
# convention keeps working, but it cannot be revoked per client and gives
# the logs nobody to name. Generate with `openssl rand -hex 32`.
GATEWAY_AUTH_TOKEN=

# Set to 1 ONLY if something upstream (your own reverse proxy, a VPN, a
# provider auth edge) already authenticates every connection. This is the
# explicit way to say "unauthenticated is intended here".
GATEWAY_ALLOW_ANONYMOUS=
