name: "whisper_asr"
backend: "python"
max_batch_size: 8

input [
  {
    name: "AUDIO_SAMPLES"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "SAMPLE_RATE"
    data_type: TYPE_INT32
    dims: [ 1 ]
    optional: true
  }
]

output [
  {
    name: "TRANSCRIPT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

# model.py now batches every request bundled into one execute() call into
# a single generate() call -- this is what lets that actually happen under
# concurrent load instead of Triton dispatching one request at a time.
#
# default_queue_policy adds admission control / backpressure: previously a
# request that arrived while whisper_asr's single instance was busy just
# queued indefinitely. Measured single-instance p50 after the batching fix
# is ~0.75s under load (README); a request still waiting 2.5s (~3x that) is
# a genuine sign of overload rather than normal queuing jitter, so reject it
# fast instead of making the caller wait. max_queue_size 32 matches the
# highest concurrency this was load-tested at (README's load-test sweeps go
# up to 32).
dynamic_batching {
  preferred_batch_size: [ 4, 8 ]
  max_queue_delay_microseconds: 50000
  default_queue_policy {
    timeout_action: REJECT
    default_timeout_microseconds: 2500000
    max_queue_size: 32
  }
}

parameters: {
  key: "engine_dir"
  value: { string_value: "/workspace/speech-cascade-inference/models/whisper-base-trtllm" }
}
parameters: {
  key: "assets_dir"
  value: { string_value: "/workspace/speech-cascade-inference/models/whisper-base-trtllm/assets" }
}
