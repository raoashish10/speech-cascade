name: "whisper_asr"
backend: "python"
max_batch_size: 8

input [
  {
    name: "AUDIO_SAMPLES"
    data_type: TYPE_FP32
    dims: [ -1 ]
  },
  {
    name: "SAMPLE_RATE"
    data_type: TYPE_INT32
    dims: [ 1 ]
    optional: true
  }
]

output [
  {
    name: "TRANSCRIPT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

# model.py now batches every request bundled into one execute() call into
# a single generate() call -- this is what lets that actually happen under
# concurrent load instead of Triton dispatching one request at a time.
dynamic_batching {
  preferred_batch_size: [ 4, 8 ]
  max_queue_delay_microseconds: 50000
}

parameters: {
  key: "model_dir"
  value: { string_value: "/workspace/speech-cascade-inference/models/whisper-base" }
}
