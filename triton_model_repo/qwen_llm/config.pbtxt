name: "qwen_llm"
backend: "python"
max_batch_size: 0

model_transaction_policy {
  decoupled: true
}

input [
  {
    name: "PROMPT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

output [
  {
    name: "GENERATED_TEXT"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

# dynamic_batching intentionally removed: it only ever helped because
# execute() used to hand Triton's whole bundled request list to one blocking
# self.llm.generate(prompts, ...) call. generate_async() only accepts a
# single prompt -- there's no batched streaming call left to feed. Real
# batching now happens because TRT-LLM's own continuous-batching executor
# sees multiple concurrent generate_async() calls in flight (one per request
# thread), the same mechanism already observed empirically to give
# nemotron_llm ~0 queue time. With streaming, dynamic_batching's only
# remaining effect would be adding up to 50ms of pure time-to-first-token
# latency for no batching benefit -- a bad tradeoff for real-time voice.

parameters: {
  key: "engine_dir"
  value: { string_value: "/workspace/speech-cascade-inference/models/Qwen3-8B-NVFP4" }
}
parameters: {
  key: "tokenizer_dir"
  value: { string_value: "/workspace/speech-cascade-inference/models/Qwen3-8B-NVFP4" }
}
# Only read when QWEN_BACKEND=pytorch (model.py) -- the unaccelerated,
# no-TensorRT-LLM comparison path. Standard unquantized Qwen/Qwen3-8B
# checkpoint (not the NVFP4 one above -- see model.py's QWEN_BACKEND comment
# for why), loaded via bitsandbytes 8-bit through plain HF transformers.
parameters: {
  key: "pytorch_model_dir"
  value: { string_value: "/workspace/speech-cascade-inference/models/Qwen3-8B-hf" }
}
